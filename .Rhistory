# Print the names of the list output
names(l)
# Display specific cutoff values as required by the lab output
cat("loglamcut:\n")
print(l$loglamcut)
cat("\nybarcut:\n")
print(l$ybarcut)
cat("\nybarcutest:\n")
print(l$ybarcutest)
